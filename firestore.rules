rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function mine(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // One counted visit to a mushaf page: exactly the fields the app writes, and nothing else.
    function isReading() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'page', 'khatma', 'startAt', 'endAt', 'durationMs'])
        && d.id is string
        && d.page is number && d.page >= 1 && d.page <= 604
        && d.khatma is number && d.khatma >= 1
        && d.startAt is number
        && d.endAt is number
        && d.durationMs is number && d.durationMs >= 0;
    }

    // Each person reads and writes only their own data, and only in the shapes the app uses:
    // anyone can open an anonymous account, so an unconstrained subtree is a free-quota target.
    match /users/{uid} {
      match /readings/{readingId} {
        allow read: if mine(uid);
        allow write: if mine(uid) && isReading();
      }

      // Device documents: `state` is the reading state itself, the rest are { data, updatedAt } wrappers.
      match /profile/{name} {
        allow read: if mine(uid);
        allow write: if mine(uid) && (
          name == 'state'
          || (name in ['groups', 'adhkar', 'audio'] && request.resource.data.keys().hasOnly(['data', 'updatedAt']))
        );
      }

      // Family sharing (phase 3) will widen this read to the members of the same family.
      match /status/public {
        allow read, write: if mine(uid);
      }
    }
  }
}
